# Generated automatically by scripts/new-docker-env.*. Keep the resulting .env
# private and never commit it.

COMPOSE_PROJECT_NAME=rugram-main
RUGRAM_DEPLOYMENT_PROFILE=main-monolith-v1
RUGRAM_IMAGE_PREFIX=ghcr.io/yvafa0975-ux/rugram
RUGRAM_IMAGE_TAG=main
RUGRAM_SERVER_BUILD_TARGET=server-test
RUGRAM_LOG_LEVEL=info

# Build provenance for local builds.
RUGRAM_BUILD_COMMIT=unknown
RUGRAM_BUILD_BRANCH=main
RUGRAM_BUILD_TREE_STATE=unknown
RUGRAM_BUILD_DATE=unknown

# The host-network server and admin reach these dependencies through loopback.
POSTGRES_DB=rugram_main
POSTGRES_USER=rugram
POSTGRES_PASSWORD=CHANGEME
RUGRAM_POSTGRES_HOST_PORT=15432
RUGRAM_POSTGRES_DSN=postgres://rugram:CHANGEME@127.0.0.1:15432/rugram_main?sslmode=disable
RUGRAM_REDIS_HOST_PORT=16379
RUGRAM_REDIS_ADDR=127.0.0.1:16379
RUGRAM_REDIS_PASSWORD=CHANGEME

# Independent random values generated for each deployment.
RUGRAM_ADMIN_API_TOKEN=CHANGEME
RUGRAM_ADMIN_UI_PASSWORD=CHANGEME
RUGRAM_ADMIN_UI_TOKEN=
RUGRAM_ADMIN_SESSION_KEY=CHANGEME
RUGRAM_TURN_SECRET=CHANGEME
RUGRAM_OTP_WEBHOOK_SECRET=CHANGEME

# Development delivery is accepted automatically on loopback. Internet-facing
# deployments must explicitly opt in or replace it with the webhook provider.
RUGRAM_DEV_AUTH_CODE=12345
RUGRAM_PHONE_CODE_DELIVERY_PROVIDER=development
RUGRAM_ALLOW_INSECURE_DEVELOPMENT_AUTH=false
RUGRAM_OTP_WEBHOOK_URL=
RUGRAM_OTP_WEBHOOK_TIMEOUT=5s

# The published main test image deliberately contains a public test RSA key so
# fresh test clients share one fingerprint. Existing server_state is preserved.
# Build target "server" plus mode "generated" for a private deployment identity.
RUGRAM_RSA_IDENTITY_MODE=test

# Must be a client-reachable IP address, never a DNS name.
RUGRAM_ADVERTISE_IP=CHANGEME
RUGRAM_SERVER_PORT=2398
RUGRAM_DEFAULT_COUNTRY_CODE=CN
RUGRAM_PUBLIC_BASE_URL=CHANGEME
RUGRAM_PUBLIC_APP_SCHEME=rugram
# Optional host-based client link root, e.g. owpg://chat.example.com for OwpenGram.
# RUGRAM_PUBLIC_APP_LINK_BASE=
RUGRAM_PUBLIC_WEB_BASE_URL=CHANGEME
RUGRAM_PUBLIC_LINK_PORT=2401
# HTTP Bot API gateway (docs/bot-api.en.md); empty keeps it disabled.
# Host network mode only: bridge mode does not publish this port.
# RUGRAM_BOT_API_ADDR=127.0.0.1:8081
# Host directory with sticker/reaction seed exports, mounted read-only.
# RUGRAM_STICKER_SEED_HOST_DIR=../../data/sticker-seed

# The monolith owns SFU, TURN, and RTMP. Host mode avoids one Docker mapping per
# TURN relay port. Bridge mode publishes a bounded 64-port compatibility range.
RUGRAM_SERVER_HOST_NETWORK=true
RUGRAM_SFU_ENABLE=true
RUGRAM_SFU_UDP_PORT=12399
RUGRAM_SFU_ADVERTISE_IP=CHANGEME
RUGRAM_TURN_ENABLE=true
RUGRAM_TURN_UDP_PORT=12400
RUGRAM_TURN_ADVERTISE_IP=CHANGEME
RUGRAM_TURN_RELAY_MIN_PORT=12500
RUGRAM_TURN_RELAY_MAX_PORT=12999
RUGRAM_TURN_BRIDGE_RELAY_MAX_PORT=12563
RUGRAM_CALL_TURN_CREDENTIAL_TTL=6h
RUGRAM_CALL_FORCE_RELAY=false
RUGRAM_LIVESTREAM_ENABLE=true
RUGRAM_LIVESTREAM_RTMP_PORT=2400
RUGRAM_LIVESTREAM_RTMP_URL=CHANGEME

# Direct host listeners and their health-probe addresses.
RUGRAM_PUBLIC_BIND_IP=127.0.0.1
RUGRAM_PUBLIC_LISTEN_HOST=127.0.0.1
RUGRAM_LOCAL_BIND_IP=127.0.0.1
RUGRAM_LOCAL_LISTEN_HOST=127.0.0.1
RUGRAM_SERVER_HEALTH_IP=127.0.0.1
RUGRAM_SERVER_HEALTH_URL_HOST=127.0.0.1
RUGRAM_ADMIN_API_PORT=2599
RUGRAM_ADMIN_BIND_IP=127.0.0.1
RUGRAM_ADMIN_LISTEN_HOST=127.0.0.1
RUGRAM_ADMIN_HEALTH_IP=127.0.0.1
RUGRAM_ADMIN_PORT=2600

# Durable media state. Switching an existing deployment between localfs and S3
# requires the explicit blob migration procedure.
RUGRAM_BLOB_BACKEND=localfs
RUGRAM_EXTERNAL_MEDIA_ENABLE=true
RUGRAM_WEBPAGE_PREVIEW_ENABLE=true
RUGRAM_S3_ENDPOINT=
RUGRAM_S3_REGION=
RUGRAM_S3_BUCKET=
RUGRAM_S3_ACCESS_KEY_ID=
RUGRAM_S3_SECRET_ACCESS_KEY=
RUGRAM_S3_USE_SSL=true
RUGRAM_S3_PATH_STYLE=false
RUGRAM_S3_CREATE_BUCKET=false
